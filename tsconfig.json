{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "./dist",
        "types": ["node", "jest"],
        "sourceMap": true,
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "*.spec.ts", "*.test.ts"],
    "exclude": ["node_modules", "dist"]
}
